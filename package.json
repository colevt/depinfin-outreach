{
  "name": "depinfin-outreach",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node --experimental-strip-types packages/db/src/migrate.ts",
    "worker:dispatch": "node --experimental-strip-types apps/worker/src/jobs/dispatch.ts",
    "worker:dry-run": "node --experimental-strip-types apps/worker/src/jobs/dispatch.ts --dry-run",
    "worker:poll-replies": "node --experimental-strip-types apps/worker/src/jobs/poll-replies.ts"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
