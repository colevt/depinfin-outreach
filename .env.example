# Application database role. This role must NOT own the tables.
# Migration 0003 revokes UPDATE/DELETE on activity_log and DELETE on suppressions from it (INV-5).
DATABASE_URL=postgres://depinfin_app:CHANGE_ME@localhost:5432/depinfin

# Migration/owner role. Used only by pnpm db:migrate, never by the app or worker.
MIGRATION_DATABASE_URL=postgres://depinfin_owner:CHANGE_ME@localhost:5432/depinfin

# INV-9 warm transport: Gmail API OAuth, primary domain, real operator inbox.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_OPERATOR_ADDRESS=ops@depinfin.com

# INV-9 cold transport: separate sending domain. Startup fails if this matches PRIMARY_DOMAIN.
PRIMARY_DOMAIN=depinfin.com
COLD_SENDING_DOMAIN=
COLD_ESP_API_KEY=

# Section 6 gate 12. Counted from activity_log, never from memory.
DAILY_SEND_CAP=40

# Operator desk. WEB_FIXTURES=1 reviews the UI without Postgres.
# OPERATOR_ACTOR is the default name written to activity_log.
OPERATOR_ACTOR=cole
WEB_FIXTURES=0
